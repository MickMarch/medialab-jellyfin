# Jellyfin server
# Use 127.0.0.1 when running directly on the host.
# Use host.docker.internal when running inside a Docker container.
JELLYFIN_HOST=127.0.0.1
JELLYFIN_PORT=8096
JELLYFIN_API_KEY=
# Seconds between checks that the Jellyfin key still works; a refusal on any
# live call is reported at once regardless.
CREDENTIAL_CHECK_INTERVAL_SECONDS=21600

# API server (defaults shown)
# 0.0.0.0 binds all interfaces, required in Docker. Use 127.0.0.1 to restrict
# a bare-host deployment to localhost.
API_HOST=0.0.0.0
API_PORT=8001

# API authentication
# The key callers (the orchestrator) must send in X-API-Key.
API_KEY=
